PORT=5000
NODE_ENV=production

# Neon PostgreSQL Database Connection String
# Get this from your Neon Console or use the production branch URL
DATABASE_URL="postgresql://neondb_owner:<password>@<endpoint>-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:<password>@<endpoint>.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=30d
